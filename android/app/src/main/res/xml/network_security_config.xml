<?xml version="1.0" encoding="utf-8"?>
<!-- The engine runs on this phone at http://127.0.0.1, and users may point the app at
     OpenWave on their own computer over the home network, which is plain http. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
